# ==============================================================================
# SOLARAUDIT.ONLINE — Production Apache Configuration (.htaccess)
# ==============================================================================

# 1. Canonical 301 Redirects: Force HTTPS & non-www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.solaraudit\.online [NC]
  RewriteRule ^(.*)$ https://solaraudit.online/$1 [L,R=301]

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://solaraudit.online/$1 [L,R=301]
</IfModule>

# 2. Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. Leverage Browser Caching (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents: re-validate regularly for fresh tariffs
  ExpiresByType text/html "access plus 1 hour"

  # Data feeds
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"

  # Static assets (CSS, JS, Fonts)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media & Icons
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

# 4. Security & Performance Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Exclude widget.html from X-Frame-Options to allow embedding across external websites
  SetEnvIf Request_URI "(widget\.html)$" IS_WIDGET
  Header set X-Frame-Options "SAMEORIGIN" env=!IS_WIDGET
  Header set Content-Security-Policy "frame-ancestors *" env=IS_WIDGET

  <Files "widget.html">
    Header unset X-Frame-Options
    Header always unset X-Frame-Options
    Header set Content-Security-Policy "frame-ancestors *"
    Header always set Content-Security-Policy "frame-ancestors *"
  </Files>
</IfModule>

# 5. Disable Directory Browsing
Options -Indexes
